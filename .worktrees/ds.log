@import "tailwindcss";

/* Palette C "Cobalt & coral", committed strategy (impeccable brand register):
   neutrals are tinted toward the cobalt hue (oklch h 265), never warm greige.
   Projects is a deep-cobalt chapter (Cartier sapphire). Coral is a FILL only.
   Measured 2026-10-23: ink/paper 17.36 · ink-2/paper 6.55 · white/cobalt 5.99 ·
   cobalt/paper 5.74 · paper/deep 13.66 · mist/deep 9.31 */
:root {
  --paper: #f9fafd;
  --paper-2: #eef1f8;
  --ink: #0f1624;
  --ink-2: #515b6f;
  --line: #d9dee8;
  --cobalt: #1c4dfb;
  --cobalt-ink: #ffffff;
  --coral: #ff6a3d;
  --deep: #061d7c; /* projects chapter background */
  --deep-2: #0f2e94;
  --mist: #c1d1f3; /* secondary text on deep */
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --dur-fast: 180ms;
  --dur-hover: 200ms;
  --dur-base: 600ms;
  --dur-slow: 1200ms;

  /* Depth system: shadow as border (Vercel/Linear), 2026-10-23.
     Three layers: edge ring, contact shadow, ambient shadow. */
  --shadow-card:
    0 0 0 1px oklch(0 0 0 / 0.06),
    0 1px 2px -1px oklch(0 0 0 / 0.06),
    0 2px 4px 0 oklch(0 0 0 / 0.04);
  --shadow-card-hover:
    0 0 0 1px oklch(0 0 0 / 0.08),
    0 1px 2px -1px oklch(0 0 0 / 0.08),
    0 2px 4px 0 oklch(0 0 0 / 0.06);
  --shadow-raised:
    0 0 0 1px oklch(0 0 0 / 0.06),
    0 2px 16px oklch(0 0 0 / 0.08),
    0 8px 32px oklch(0 0 0 / 0.06);
  /* Primary action: inner top highlight + inner bottom shade + contact shadow. */
  --shadow-primary:
    inset 0 1px 0 rgb(255 255 255 / 0.18),
    inset 0 -1px 0 rgb(0 0 0 / 0.12),
    0 1px 2px rgb(0 0 0 / 0.12);
}

@theme inline {
  --color-paper: var(--paper);
  --color-paper-2: var(--paper-2);
  --color-ink: var(--ink);
  --color-ink-2: var(--ink-2);
  --color-line: var(--line);
  --color-cobalt: var(--cobalt);
  --color-cobalt-ink: var(--cobalt-ink);
  --color-coral: var(--coral);
  --color-deep: var(--deep);
  --color-deep-2: var(--deep-2);
  --color-mist: var(--mist);
  --font-display: var(--font-bricolage);
  --font-sans: var(--font-geist);
  --ease-out-soft: var(--ease-out);
  --shadow-card: var(--shadow-card);
  --shadow-card-hover: var(--shadow-card-hover);
  --shadow-raised: var(--shadow-raised);
  --shadow-primary: var(--shadow-primary);
}

html { scroll-behavior: auto; }
body {
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-geist), system-ui, sans-serif;
}
h1, h2, h3 { font-family: var(--font-bricolage), system-ui, sans-serif; letter-spacing: -0.02em; text-wrap: balance; }
/* Hero photo mask: 120px top-left, 12px elsewhere (BRIEF decision). */
.hero-photo { border-radius: 12px; border-top-left-radius: 120px; }
section[id] { scroll-margin-top: 96px; }
:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 3px; }

/* Feedback motion: transform and shadow only, on the hover duration token. */
.press {
  transition:
    transform var(--dur-hover) var(--ease-out),
    box-shadow var(--dur-hover) var(--ease-out),
    opacity var(--dur-hover) var(--ease-out);
}
.press:active { transform: translateY(1px); }

.lift {
  transition:
    transform var(--dur-hover) var(--ease-out),
    box-shadow var(--dur-hover) var(--ease-out);
}
@media (hover: hover) {
  .lift:hover { transform: translateY(-2px); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

/* m1 scroll-scrubbed stages: end state from first paint under reduced motion. */
@media (prefers-reduced-motion: reduce) {
  [data-testid="portal-window"] { clip-path: inset(0% 0% round 0px) !important; transform: none !important; }
  [data-testid="portal-window"] img { transform: none !important; }
  [data-testid="parallax"] [data-speed] { transform: none !important; }
}

@layer components {
/* Buttons (impeccable + Emil Kowalski): lit from above, colored ambient shadow,
   0.97 press in 100ms, release on the hover duration. Hover only on fine pointers. */
.btn {
  position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  min-height: 3rem; padding-inline: 1.375rem; border-radius: 999px; font-weight: 600; font-size: 1rem;
  transition: transform var(--dur-hover) var(--ease-out), box-shadow var(--dur-hover) var(--ease-out), background-color var(--dur-hover) var(--ease-out);
}
.btn:active { transform: scale(0.97); transition-duration: 100ms; }
.btn-sm { min-height: 3rem; padding-inline: 1rem; font-size: 0.875rem; }
.btn-icon { width: 3rem; padding-inline: 0; }
.btn .btn-arrow { transition: transform var(--dur-hover) var(--ease-out); }
.btn-primary {
  color: #fff;
  background: var(--cobalt) linear-gradient(180deg, rgb(255 255 255 / 0.14), rgb(255 255 255 / 0) 55%);
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.28), inset 0 -1px 0 rgb(6 29 124 / 0.35),
    0 1px 2px rgb(6 29 124 / 0.3), 0 6px 16px -6px rgb(28 77 251 / 0.55);
}
.btn-secondary {
  color: var(--ink); background: #fff;
  box-shadow: inset 0 1px 0 #fff, 0 0 0 1px rgb(15 22 36 / 0.1), 0 1px 2px rgb(15 22 36 / 0.06), 0 4px 12px -6px rgb(15 22 36 / 0.12);
}
.btn-light { color: var(--deep); background: var(--paper); box-shadow: inset 0 1px 0 #fff, 0 1px 2px rgb(0 0 0 / 0.2), 0 8px 20px -8px rgb(0 0 0 / 0.45); }
.btn-ghost-light { color: var(--paper); background: rgb(255 255 255 / 0.08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22); }
.btn[aria-disabled="true"] { cursor: default; }
.btn[aria-disabled="true"]:active { transform: none; }
@media (hover: hover) and (pointer: fine) {
  .btn-primary:hover { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.32), inset 0 -1px 0 rgb(6 29 124 / 0.35), 0 2px 4px rgb(6 29 124 / 0.3), 0 10px 24px -8px rgb(28 77 251 / 0.65); }
  .btn-secondary:hover { box-shadow: inset 0 1px 0 #fff, 0 0 0 1px rgb(15 22 36 / 0.16), 0 2px 4px rgb(15 22 36 / 0.08), 0 8px 18px -8px rgb(15 22 36 / 0.18); }
  .btn-light:hover, .btn-ghost-light:hover { transform: translateY(-1px); }
  .btn:not([aria-disabled="true"]):hover .btn-arrow { transform: translateX(3px); }
}
/* Form surfaces: the panel is a raised sheet; fields are inset wells with a soft cobalt focus halo. */
.field-panel { background: #fff; box-shadow: 0 0 0 1px rgb(15 22 36 / 0.06), 0 1px 2px rgb(15 22 36 / 0.04), 0 24px 48px -24px rgb(15 22 36 / 0.18); }
.field {
  background: var(--paper); border: 1px solid transparent;
  box-shadow: inset 0 1px 2px rgb(15 22 36 / 0.06), 0 0 0 1px rgb(15 22 36 / 0.1);
  transition: box-shadow var(--dur-hover) var(--ease-out), background-color var(--dur-hover) var(--ease-out);
}
.field:hover { box-shadow: inset 0 1px 2px rgb(15 22 36 / 0.06), 0 0 0 1px rgb(15 22 36 / 0.18); }
.field:focus { outline: none; background: #fff; box-shadow: 0 0 0 1px var(--cobalt), 0 0 0 4px rgb(28 77 251 / 0.18); }
.soon { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.125rem 0.5rem; border-radius: 999px; background: var(--paper-2); color: var(--ink-2); }

/* Liquid glass: ONE surface (the floating nav), doing one job (staying legible over moving content). */
.glass-nav {
  background: rgb(249 250 253 / 0.62);
  -webkit-backdrop-filter: blur(16px) saturate(180%); backdrop-filter: blur(16px) saturate(180%);
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.75), inset 0 -1px 0 rgb(15 22 36 / 0.04),
    0 0 0 1px rgb(15 22 36 / 0.07), 0 10px 30px -12px rgb(15 22 36 / 0.25);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .glass-nav { background: var(--paper); } }
@media (prefers-reduced-transparency: reduce) { .glass-nav { background: var(--paper); backdrop-filter: none; -webkit-backdrop-filter: none; } }

}
